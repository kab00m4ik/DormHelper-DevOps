# Загальні параметри середовища
FRONTEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# База даних PostgreSQL
POSTGRES_DB=dormhelper_dev
POSTGRES_USER=dormhelper_user
POSTGRES_PASSWORD=changeme_db_password

# Об'єктне сховище MinIO
MINIO_ROOT_USER=dormhelper_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=dormhelper-photos

# Безпека / Токени
JWT_SIGNING_KEY=changeme_jwt_signing_key
